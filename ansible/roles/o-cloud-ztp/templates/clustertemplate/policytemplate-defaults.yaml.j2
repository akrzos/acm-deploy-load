---
apiVersion: v1
kind: ConfigMap
metadata:
  name: policytemplate-defaults
  namespace: {{ ocloud_clustertemplate_ns }}
data:
  policytemplate-defaults: |
    cpu-isolated: "2-31"
    cpu-reserved: "0-1"
    hugepages-count: "16"
    hugepages-default: "1G"
    hugepages-size: "1G"
    install-plan-approval: "Automatic"
    sriov-network-vlan-1: "140"
    sriov-network-pfNames-1: '["ens2f0"]'
