---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ocloud-clusters
  namespace: openshift-gitops
spec:
  destination:
    server: https://kubernetes.default.svc
  project: ztp
  source:
    path: {{ ztp_argocd_base_path }}/clustertemplates
    repoURL: {{ ztp_gitops_repo_url }}
    targetRevision: main
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
  ignoreDifferences:
  - group: metal3.io
    jsonPointers:
    - /spec/preprovisioningNetworkDataName
    - /spec/online
    kind: BareMetalHost
