---
{% if ai_siteconfig_map_site_data %}
apiVersion: ran.openshift.io/v2
{% else %}
apiVersion: ran.openshift.io/v1
{% endif %}
kind: SiteConfig
metadata:
  name: {{ sno_host }}
  namespace: {{ sno_host }}
spec:
  baseDomain: {{ hostvars[sno_host]['base_domain'] }}
  pullSecretRef:
    name: "ai-pull-secret"
  clusterImageSetNameRef: {{ cluster_image_set }}
  sshPublicKey: {{ lookup('file', ssh_public_key_file) }}
  clusters:
  - clusterName: {{ sno_host }}
    networkType: "OVNKubernetes"
    extraManifestPath: extra-manifests
{% if sno_du_profile == "4.15" %}
    # 4.15
    installConfigOverrides:  "{\"capabilities\":{\"baselineCapabilitySet\": \"None\", \"additionalEnabledCapabilities\": [ \"OperatorLifecycleManager\", \"NodeTuning\" ] }}"
    # 4.16, 4.17, 4.18, 4.19, 4.20
    # installConfigOverrides:  "{\"capabilities\":{\"baselineCapabilitySet\": \"None\", \"additionalEnabledCapabilities\": [ \"OperatorLifecycleManager\", \"Ingress\", \"NodeTuning\" ] }}"
{% elif sno_du_profile in ["4.16", "4.17", "4.18", "4.19", "4.20"] %}
    # 4.15
    # installConfigOverrides:  "{\"capabilities\":{\"baselineCapabilitySet\": \"None\", \"additionalEnabledCapabilities\": [ \"OperatorLifecycleManager\", \"NodeTuning\" ] }}"
    # 4.16, 4.17, 4.18, 4.19, 4.20
    installConfigOverrides:  "{\"capabilities\":{\"baselineCapabilitySet\": \"None\", \"additionalEnabledCapabilities\": [ \"OperatorLifecycleManager\", \"Ingress\", \"NodeTuning\" ] }}"
    ignitionConfigOverride: "{\"ignition\":{\"version\":\"3.2.0\"},\"storage\":{\"files\":[{\"path\":\"/etc/containers/policy.json\",\"mode\":420,\"overwrite\":true,\"contents\":{\"source\":\"data:text/plain;charset=utf-8;base64,\"}}]}}"
{% else %}
{% if ai_siteconfig_fips %}
    installConfigOverrides: '{ "fips": true }'
{% endif %}
{% endif %}
    clusterLabels:
      cloud: auto-detect
      common: 'true'
{% if sno_du_profile in ["4.15", "4.16", "4.17", "4.18", "4.19", "4.20"] %}
      du-profile: "{{ sno_du_profile }}"
{% endif %}
      group-du-sno: ''
      name: {{ sno_host }}
{% if sno_mc_observability %}
      observability: enabled
{% else %}
      observability: disabled
{% endif %}
      sites: {{ sno_host }}
      vendor: auto-detect
    clusterNetwork:
    - cidr: {{ "fd01::/48" if hostvars[sno_host]['ip'] | ansible.utils.ipv6 else "10.128.0.0/14" }}
      hostPrefix: {{ sno_cluster_network_host_prefix }}
    machineNetwork:
    - cidr: {{ hostvars[sno_host]['machine_network'] }}
    serviceNetwork:
    - {{ "fd02::/112" if hostvars[sno_host]['ip'] | ansible.utils.ipv6 else "172.30.0.0/16" }}
    additionalNTPSources:
    - {{ hostvars[sno_host]['hv_ip'] }}
    crTemplates:
      KlusterletAddonConfig: "KlusterletAddonConfigOverride.yaml"
{% if ai_siteconfig_map_site_data %}
    siteConfigMap:
      name: site-{{ sno_host }}
      namespace: {{ ai_site_data_namespace }}
      data:
        sitekey1: "sitevalue1"
        sitekey2: "sitevalue2"
        sitekey3: "sitevalue3"
        sitekey4: "sitevalue4"
{% endif %}
    nodes:
    - hostName: "{{ sno_host }}"
{% if ai_siteconfig_ironic_inspect %}
      ironicInspect: enabled
{% else %}
      ironicInspect: disabled
{% endif %}
{% if hostvars[sno_host]['ip'] | ansible.utils.ipv4 %}
      bmcAddress: redfish-virtualmedia+http://{{ hostvars[sno_host]['hv_ip'] }}:9000/redfish/v1/Systems/{{ hostvars[sno_host]['domain_uuid'] }}
{% else %}
      bmcAddress: redfish-virtualmedia+http://[{{ hostvars[sno_host]['hv_ip'] }}]:9000/redfish/v1/Systems/{{ hostvars[sno_host]['domain_uuid'] }}
{% endif %}
      bmcCredentialsName:
        name: {{ sno_host }}-bmc-secret
      bootMACAddress: {{ hostvars[sno_host]['mac_address'] }}
      bootMode: "UEFI"
      # rootDeviceHints:
      #   hctl: '0:0:0:0'
{% if ai_siteconfig_enable_cpuset %}
      cpuset: "{{ ai_siteconfig_cpuset }}"
{% else %}
      # cpuset: "{{ ai_siteconfig_cpuset }}"
{% endif %}
      nodeNetwork:
        interfaces:
        - name: {{ sno_nic_interface }}
          macAddress: {{ hostvars[sno_host]['mac_address'] }}
        config:
          interfaces:
          - name: {{ sno_nic_interface }}
            type: ethernet
            state: up
{% if hostvars[sno_host]['ip'] | ansible.utils.ipv4 %}
            ipv4:
              enabled: true
              autoconf: false
              dhcp: false
              address:
              - ip: "{{ hostvars[sno_host]['ip'] }}"
                prefix-length: {{ hostvars[sno_host]['network_prefix'] }}
            ipv6:
              enabled: false
{% else %}
            ipv4:
              enabled: false
            ipv6:
              enabled: true
              autoconf: false
              dhcp: false
              address:
              - ip: "{{ hostvars[sno_host]['ip'] }}"
                prefix-length: {{ hostvars[sno_host]['network_prefix'] }}
{% endif %}
          dns-resolver:
            config:
              server:
              - {{ hostvars[sno_host]['hv_ip'] }}
          routes:
            config:
            - destination: {{ "::/0" if hostvars[sno_host]['ip'] | ansible.utils.ipv6 else "0.0.0.0/0" }}
              next-hop-interface: {{ sno_nic_interface }}
              next-hop-address: {{ hostvars[sno_host]['gateway'] }}
              table-id: 254
